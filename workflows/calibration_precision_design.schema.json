{
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "cluster_design_effect": {
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Cluster Design Effect",
      "type": "number"
    },
    "confidence_level": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.5,
      "title": "Confidence Level",
      "type": "number"
    },
    "design_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Design Version",
      "type": "string"
    },
    "estimand": {
      "pattern": "^technical_label_retention_probability$",
      "title": "Estimand",
      "type": "string"
    },
    "expected_retention_probability": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Expected Retention Probability",
      "type": "number"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "maximum_pair_observations": {
      "maximum": 1000000,
      "minimum": 2,
      "title": "Maximum Pair Observations",
      "type": "integer"
    },
    "minimum_pair_observations": {
      "minimum": 2,
      "title": "Minimum Pair Observations",
      "type": "integer"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "outcome_data_accessed": {
      "title": "Outcome Data Accessed",
      "type": "boolean"
    },
    "parameters_are_hypothetical": {
      "title": "Parameters Are Hypothetical",
      "type": "boolean"
    },
    "patient_level_data_accessed": {
      "title": "Patient Level Data Accessed",
      "type": "boolean"
    },
    "scenario_id": {
      "pattern": "^SYNTHETIC-CAL-[A-Z0-9-]+$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_selected": {
      "title": "Source Selected",
      "type": "boolean"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "target_interval_half_width": {
      "exclusiveMaximum": 0.5,
      "exclusiveMinimum": 0.0,
      "title": "Target Interval Half Width",
      "type": "number"
    },
    "threshold_selection_authorized": {
      "title": "Threshold Selection Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "design_version",
    "scenario_id",
    "study_id",
    "estimand",
    "expected_retention_probability",
    "confidence_level",
    "target_interval_half_width",
    "cluster_design_effect",
    "minimum_pair_observations",
    "maximum_pair_observations",
    "assumptions",
    "limitations",
    "parameters_are_hypothetical",
    "source_selected",
    "patient_level_data_accessed",
    "molecular_values_accessed",
    "outcome_data_accessed",
    "threshold_selection_authorized",
    "study_execution_authorized"
  ],
  "title": "TechnicalReplicatePrecisionDesign",
  "type": "object"
}
