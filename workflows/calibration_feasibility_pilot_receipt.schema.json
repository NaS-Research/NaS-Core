{
  "$defs": {
    "SourcePilotSummary": {
      "additionalProperties": false,
      "properties": {
        "analysis_scale": {
          "title": "Analysis Scale",
          "type": "string"
        },
        "bootstrap_rmse_ci_lower": {
          "minimum": 0,
          "title": "Bootstrap Rmse Ci Lower",
          "type": "number"
        },
        "bootstrap_rmse_ci_upper": {
          "minimum": 0,
          "title": "Bootstrap Rmse Ci Upper",
          "type": "number"
        },
        "bootstrap_spearman_ci_lower": {
          "maximum": 1,
          "minimum": -1,
          "title": "Bootstrap Spearman Ci Lower",
          "type": "number"
        },
        "bootstrap_spearman_ci_upper": {
          "maximum": 1,
          "minimum": -1,
          "title": "Bootstrap Spearman Ci Upper",
          "type": "number"
        },
        "eligible_replicate_group_count": {
          "exclusiveMinimum": 0,
          "title": "Eligible Replicate Group Count",
          "type": "integer"
        },
        "highest_difference_genes": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Highest Difference Genes",
          "type": "array"
        },
        "inferential_claim_authorized": {
          "title": "Inferential Claim Authorized",
          "type": "boolean"
        },
        "maximum_gene_absolute_difference": {
          "minimum": 0,
          "title": "Maximum Gene Absolute Difference",
          "type": "number"
        },
        "maximum_group_spearman": {
          "maximum": 1,
          "minimum": -1,
          "title": "Maximum Group Spearman",
          "type": "number"
        },
        "median_gene_absolute_difference": {
          "minimum": 0,
          "title": "Median Gene Absolute Difference",
          "type": "number"
        },
        "median_group_mae": {
          "minimum": 0,
          "title": "Median Group Mae",
          "type": "number"
        },
        "median_group_pearson": {
          "maximum": 1,
          "minimum": -1,
          "title": "Median Group Pearson",
          "type": "number"
        },
        "median_group_rmse": {
          "minimum": 0,
          "title": "Median Group Rmse",
          "type": "number"
        },
        "median_group_spearman": {
          "maximum": 1,
          "minimum": -1,
          "title": "Median Group Spearman",
          "type": "number"
        },
        "minimum_group_spearman": {
          "maximum": 1,
          "minimum": -1,
          "title": "Minimum Group Spearman",
          "type": "number"
        },
        "panel_gene_count": {
          "maximum": 50,
          "minimum": 50,
          "title": "Panel Gene Count",
          "type": "integer"
        },
        "primary_calibration_eligible": {
          "title": "Primary Calibration Eligible",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^ncbi-geo-gse(60788|130397)$",
          "title": "Source Id",
          "type": "string"
        },
        "unordered_pair_comparison_count": {
          "exclusiveMinimum": 0,
          "title": "Unordered Pair Comparison Count",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "eligible_replicate_group_count",
        "unordered_pair_comparison_count",
        "panel_gene_count",
        "analysis_scale",
        "median_group_spearman",
        "bootstrap_spearman_ci_lower",
        "bootstrap_spearman_ci_upper",
        "minimum_group_spearman",
        "maximum_group_spearman",
        "median_group_pearson",
        "median_group_mae",
        "median_group_rmse",
        "bootstrap_rmse_ci_lower",
        "bootstrap_rmse_ci_upper",
        "median_gene_absolute_difference",
        "maximum_gene_absolute_difference",
        "highest_difference_genes",
        "inferential_claim_authorized",
        "primary_calibration_eligible"
      ],
      "title": "SourcePilotSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classifier_executed": {
      "title": "Classifier Executed",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "decision": {
      "pattern": "^excluded_pilots_complete_primary_calibration_not_ready$",
      "title": "Decision",
      "type": "string"
    },
    "details_object_key": {
      "title": "Details Object Key",
      "type": "string"
    },
    "details_object_verified": {
      "title": "Details Object Verified",
      "type": "boolean"
    },
    "details_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Details Sha256",
      "type": "string"
    },
    "external_export_authorized": {
      "title": "External Export Authorized",
      "type": "boolean"
    },
    "external_publication_authorized": {
      "title": "External Publication Authorized",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "molecular_values_retained_in_git": {
      "title": "Molecular Values Retained In Git",
      "type": "boolean"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Next Actions",
      "type": "array"
    },
    "outcomes_accessed": {
      "title": "Outcomes Accessed",
      "type": "boolean"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_identifiers_retained": {
      "title": "Source Identifiers Retained",
      "type": "boolean"
    },
    "source_summaries": {
      "items": {
        "$ref": "#/$defs/SourcePilotSummary"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Source Summaries",
      "type": "array"
    },
    "sources_pooled": {
      "title": "Sources Pooled",
      "type": "boolean"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "thresholds_estimated": {
      "title": "Thresholds Estimated",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "code_revision",
    "plan_sha256",
    "source_summaries",
    "details_object_key",
    "details_sha256",
    "details_object_verified",
    "decision",
    "sources_pooled",
    "thresholds_estimated",
    "classifier_executed",
    "outcomes_accessed",
    "source_identifiers_retained",
    "molecular_values_retained_in_git",
    "external_export_authorized",
    "external_publication_authorized",
    "limitations",
    "next_actions"
  ],
  "title": "CalibrationFeasibilityPilotReceipt",
  "type": "object"
}
