{
  "additionalProperties": false,
  "properties": {
    "candidate_artifact_path": {
      "minLength": 1,
      "title": "Candidate Artifact Path",
      "type": "string"
    },
    "candidate_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Artifact Sha256",
      "type": "string"
    },
    "candidate_artifact_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Candidate Artifact Size Bytes",
      "type": "integer"
    },
    "candidate_only": {
      "title": "Candidate Only",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "coefficient_count": {
      "maximum": 250,
      "minimum": 250,
      "title": "Coefficient Count",
      "type": "integer"
    },
    "founder_approved": {
      "title": "Founder Approved",
      "type": "boolean"
    },
    "gene_count": {
      "maximum": 50,
      "minimum": 50,
      "title": "Gene Count",
      "type": "integer"
    },
    "imported_at": {
      "format": "date-time",
      "title": "Imported At",
      "type": "string"
    },
    "method_dependency_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Method Dependency Audit Sha256",
      "type": "string"
    },
    "method_execution_authorized": {
      "title": "Method Execution Authorized",
      "type": "boolean"
    },
    "molecular_data_accessed": {
      "title": "Molecular Data Accessed",
      "type": "boolean"
    },
    "outcome_data_accessed": {
      "title": "Outcome Data Accessed",
      "type": "boolean"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_distribution_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Distribution Sha256",
      "type": "string"
    },
    "source_member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Member Sha256",
      "type": "string"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "subtype_count": {
      "maximum": 5,
      "minimum": 5,
      "title": "Subtype Count",
      "type": "integer"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "question_id",
    "question_version",
    "method_dependency_audit_sha256",
    "source_distribution_sha256",
    "source_member_sha256",
    "candidate_artifact_path",
    "candidate_artifact_sha256",
    "candidate_artifact_size_bytes",
    "coefficient_count",
    "gene_count",
    "subtype_count",
    "code_revision",
    "imported_at",
    "candidate_only",
    "founder_approved",
    "method_execution_authorized",
    "molecular_data_accessed",
    "outcome_data_accessed"
  ],
  "title": "CentroidCandidateImportReceipt",
  "type": "object"
}
