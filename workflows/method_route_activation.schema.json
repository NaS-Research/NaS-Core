{
  "$defs": {
    "MethodRouteActivationStatus": {
      "enum": [
        "dependencies_pending",
        "question_redesign_required",
        "independent_calibration_hold"
      ],
      "title": "MethodRouteActivationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activated_at": {
      "format": "date-time",
      "title": "Activated At",
      "type": "string"
    },
    "activation_status": {
      "$ref": "#/$defs/MethodRouteActivationStatus"
    },
    "activation_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Activation Version",
      "type": "string"
    },
    "calibration_acquisition_active": {
      "title": "Calibration Acquisition Active",
      "type": "boolean"
    },
    "calibration_acquisition_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Acquisition Plan Sha256",
      "type": "string"
    },
    "calibration_source_selected": {
      "title": "Calibration Source Selected",
      "type": "boolean"
    },
    "centroid_candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Centroid Candidate Sha256",
      "type": "string"
    },
    "centroid_candidate_staged": {
      "title": "Centroid Candidate Staged",
      "type": "boolean"
    },
    "clinical_use_authorized": {
      "title": "Clinical Use Authorized",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "fixed_reference_resolved": {
      "title": "Fixed Reference Resolved",
      "type": "boolean"
    },
    "founder_decision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Founder Decision Sha256",
      "type": "string"
    },
    "founder_route_selected": {
      "title": "Founder Route Selected",
      "type": "boolean"
    },
    "method_dependency_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Method Dependency Audit Sha256",
      "type": "string"
    },
    "method_execution_authorized": {
      "title": "Method Execution Authorized",
      "type": "boolean"
    },
    "method_locked": {
      "title": "Method Locked",
      "type": "boolean"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "next_required_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Next Required Actions",
      "type": "array"
    },
    "outcome_data_accessed": {
      "title": "Outcome Data Accessed",
      "type": "boolean"
    },
    "patient_level_data_accessed": {
      "title": "Patient Level Data Accessed",
      "type": "boolean"
    },
    "publication_authorized": {
      "title": "Publication Authorized",
      "type": "boolean"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_preserved": {
      "title": "Question Preserved",
      "type": "boolean"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_route_id": {
      "pattern": "^ROUTE-[A-Z]$",
      "title": "Selected Route Id",
      "type": "string"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "technical_calibration_resolved": {
      "title": "Technical Calibration Resolved",
      "type": "boolean"
    },
    "thresholds_resolved": {
      "title": "Thresholds Resolved",
      "type": "boolean"
    }
  },
  "required": [
    "activation_version",
    "study_id",
    "question_id",
    "question_version",
    "selected_route_id",
    "activation_status",
    "method_dependency_audit_sha256",
    "founder_decision_sha256",
    "centroid_candidate_sha256",
    "calibration_acquisition_plan_sha256",
    "code_revision",
    "activated_at",
    "question_preserved",
    "centroid_candidate_staged",
    "calibration_acquisition_active",
    "founder_route_selected",
    "calibration_source_selected",
    "method_locked",
    "fixed_reference_resolved",
    "technical_calibration_resolved",
    "thresholds_resolved",
    "patient_level_data_accessed",
    "molecular_values_accessed",
    "outcome_data_accessed",
    "method_execution_authorized",
    "clinical_use_authorized",
    "publication_authorized",
    "next_required_actions"
  ],
  "title": "MethodRouteActivationReceipt",
  "type": "object"
}
