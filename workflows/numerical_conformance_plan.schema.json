{
  "additionalProperties": false,
  "properties": {
    "absolute_margin_tolerance": {
      "exclusiveMinimum": 0.0,
      "maximum": 1e-10,
      "title": "Absolute Margin Tolerance",
      "type": "number"
    },
    "absolute_score_tolerance": {
      "exclusiveMinimum": 0.0,
      "maximum": 1e-10,
      "title": "Absolute Score Tolerance",
      "type": "number"
    },
    "centroid_candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Centroid Candidate Sha256",
      "type": "string"
    },
    "independent_reference_implementation": {
      "pattern": "^pure_python_no_numpy_no_scipy$",
      "title": "Independent Reference Implementation",
      "type": "string"
    },
    "method_lock_authorized": {
      "title": "Method Lock Authorized",
      "type": "boolean"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "outcomes_accessed": {
      "title": "Outcomes Accessed",
      "type": "boolean"
    },
    "plan_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Plan Version",
      "type": "string"
    },
    "platform_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Platform Audit Sha256",
      "type": "string"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "required_case_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Required Case Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "synthetic_only": {
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "plan_version",
    "study_id",
    "question_id",
    "question_version",
    "platform_audit_sha256",
    "centroid_candidate_sha256",
    "absolute_score_tolerance",
    "absolute_margin_tolerance",
    "required_case_ids",
    "independent_reference_implementation",
    "synthetic_only",
    "molecular_values_accessed",
    "outcomes_accessed",
    "method_lock_authorized"
  ],
  "title": "NumericalConformancePlan",
  "type": "object"
