{
  "$defs": {
    "CompatibilityFindingStatus": {
      "enum": [
        "verified",
        "partial",
        "pending"
      ],
      "title": "CompatibilityFindingStatus",
      "type": "string"
    },
    "PlatformAuditDecision": {
      "enum": [
        "pass",
        "changes_required"
      ],
      "title": "PlatformAuditDecision",
      "type": "string"
    },
    "PlatformCompatibilityFinding": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^PLAT-[0-9]{3}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Paths",
          "type": "array"
        },
        "finding": {
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "remaining_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Requirement"
        },
        "status": {
          "$ref": "#/$defs/CompatibilityFindingStatus"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "finding",
        "evidence_paths"
      ],
      "title": "PlatformCompatibilityFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Audit Version",
      "type": "string"
    },
    "audited_at": {
      "format": "date-time",
      "title": "Audited At",
      "type": "string"
    },
    "centroid_candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Centroid Candidate Sha256",
      "type": "string"
    },
    "classifier_executed": {
      "title": "Classifier Executed",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/PlatformAuditDecision"
    },
    "decision_rationale": {
      "minLength": 1,
      "title": "Decision Rationale",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/PlatformCompatibilityFinding"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "metadata_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Metadata Receipt Sha256",
      "type": "string"
    },
    "molecular_values_parsed": {
      "title": "Molecular Values Parsed",
      "type": "boolean"
    },
    "outcome_values_parsed": {
      "title": "Outcome Values Parsed",
      "type": "boolean"
    },
    "partial_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Partial Count",
      "type": "integer"
    },
    "pending_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Pending Count",
      "type": "integer"
    },
    "planning_bundle_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Planning Bundle Sha256",
      "type": "string"
    },
    "platform_stack_selected": {
      "title": "Platform Stack Selected",
      "type": "boolean"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "raw_artifacts_stored": {
      "title": "Raw Artifacts Stored",
      "type": "boolean"
    },
    "reference_locked": {
      "title": "Reference Locked",
      "type": "boolean"
    },
    "reliability_specification_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reliability Specification Sha256",
      "type": "string"
    },
    "route_id": {
      "pattern": "^ROUTE-C$",
      "title": "Route Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_selected": {
      "title": "Source Selected",
      "type": "boolean"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "transformation_locked": {
      "title": "Transformation Locked",
      "type": "boolean"
    },
    "verified_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Verified Count",
      "type": "integer"
    }
  },
  "required": [
    "audit_version",
    "study_id",
    "question_id",
    "question_version",
    "route_id",
    "code_revision",
    "audited_at",
    "planning_bundle_sha256",
    "metadata_receipt_sha256",
    "centroid_candidate_sha256",
    "reliability_specification_sha256",
    "findings",
    "verified_count",
    "partial_count",
    "pending_count",
    "decision",
    "decision_rationale",
    "limitations",
    "molecular_values_parsed",
    "outcome_values_parsed",
    "raw_artifacts_stored",
    "classifier_executed",
    "source_selected",
    "transformation_locked",
    "reference_locked",
    "platform_stack_selected",
    "study_execution_authorized"
  ],
  "title": "PlatformCompatibilityAuditReceipt",
  "type": "object"
}
