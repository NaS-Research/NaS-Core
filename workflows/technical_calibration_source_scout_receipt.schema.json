{
  "$defs": {
    "CalibrationAccessClass": {
      "enum": [
        "public_open",
        "licensed",
        "controlled",
        "not_yet_created"
      ],
      "title": "CalibrationAccessClass",
      "type": "string"
    },
    "CalibrationSourceCandidate": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "$ref": "#/$defs/CalibrationAccessClass"
        },
        "assay_or_platform": {
          "minLength": 1,
          "title": "Assay Or Platform",
          "type": "string"
        },
        "candidate_for_threshold_calibration": {
          "title": "Candidate For Threshold Calibration",
          "type": "boolean"
        },
        "disposition": {
          "$ref": "#/$defs/CalibrationSourceDisposition"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "full_classifier_panel_confirmed": {
          "title": "Full Classifier Panel Confirmed",
          "type": "boolean"
        },
        "independent_from_classifier_training": {
          "title": "Independent From Classifier Training",
          "type": "boolean"
        },
        "independent_from_external_validation": {
          "title": "Independent From External Validation",
          "type": "boolean"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "lawful_access_verified": {
          "title": "Lawful Access Verified",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "paired_measurements_reported": {
          "title": "Paired Measurements Reported",
          "type": "boolean"
        },
        "participant_level_molecular_values_available": {
          "title": "Participant Level Molecular Values Available",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^CALSRC-[0-9]{3}$",
          "title": "Source Id",
          "type": "string"
        },
        "stable_pair_identifiers_available": {
          "title": "Stable Pair Identifiers Available",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "label",
        "evidence_ids",
        "assay_or_platform",
        "access_class",
        "disposition",
        "independent_from_classifier_training",
        "independent_from_external_validation",
        "paired_measurements_reported",
        "participant_level_molecular_values_available",
        "stable_pair_identifiers_available",
        "full_classifier_panel_confirmed",
        "lawful_access_verified",
        "candidate_for_threshold_calibration",
        "limitations"
      ],
      "title": "CalibrationSourceCandidate",
      "type": "object"
    },
    "CalibrationSourceDisposition": {
      "enum": [
        "reserved_external_validation",
        "participant_level_data_unavailable",
        "requires_due_diligence",
        "future_nas_experiment"
      ],
      "title": "CalibrationSourceDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquisition_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Acquisition Plan Sha256",
      "type": "string"
    },
    "external_contact_sent": {
      "title": "External Contact Sent",
      "type": "boolean"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/CalibrationSourceCandidate"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "method_execution_authorized": {
      "title": "Method Execution Authorized",
      "type": "boolean"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "official_source_urls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Official Source Urls",
      "type": "array"
    },
    "outcome_data_accessed": {
      "title": "Outcome Data Accessed",
      "type": "boolean"
    },
    "patient_level_data_accessed": {
      "title": "Patient Level Data Accessed",
      "type": "boolean"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommended Actions",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_complete": {
      "title": "Search Complete",
      "type": "boolean"
    },
    "search_scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Search Scope",
      "type": "array"
    },
    "searched_at": {
      "format": "date-time",
      "title": "Searched At",
      "type": "string"
    },
    "source_selected": {
      "title": "Source Selected",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "question_id",
    "question_version",
    "acquisition_plan_sha256",
    "searched_at",
    "search_scope",
    "official_source_urls",
    "findings",
    "recommended_actions",
    "search_complete",
    "patient_level_data_accessed",
    "molecular_values_accessed",
    "outcome_data_accessed",
    "source_selected",
    "external_contact_sent",
    "method_execution_authorized"
  ],
  "title": "TechnicalCalibrationSourceScoutReceipt",
  "type": "object"
}
