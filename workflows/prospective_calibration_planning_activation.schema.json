{
  "$defs": {
    "CalibrationPlanningActivationStatus": {
      "enum": [
        "internal_planning_active"
      ],
      "title": "CalibrationPlanningActivationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activated_at": {
      "format": "date-time",
      "title": "Activated At",
      "type": "string"
    },
    "activation_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Activation Version",
      "type": "string"
    },
    "clinical_use_authorized": {
      "title": "Clinical Use Authorized",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "data_access_authorized": {
      "title": "Data Access Authorized",
      "type": "boolean"
    },
    "decision_packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Decision Packet Sha256",
      "type": "string"
    },
    "design_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Design Sha256",
      "type": "string"
    },
    "external_contact_authorized": {
      "title": "External Contact Authorized",
      "type": "boolean"
    },
    "final_human_review_preserved": {
      "title": "Final Human Review Preserved",
      "type": "boolean"
    },
    "founder_decision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Founder Decision Sha256",
      "type": "string"
    },
    "internal_budget_scenario_planning_authorized": {
      "title": "Internal Budget Scenario Planning Authorized",
      "type": "boolean"
    },
    "internal_operational_scenario_planning_authorized": {
      "title": "Internal Operational Scenario Planning Authorized",
      "type": "boolean"
    },
    "internal_scientific_planning_authorized": {
      "title": "Internal Scientific Planning Authorized",
      "type": "boolean"
    },
    "internal_statistical_planning_authorized": {
      "title": "Internal Statistical Planning Authorized",
      "type": "boolean"
    },
    "laboratory_quote_authorized": {
      "title": "Laboratory Quote Authorized",
      "type": "boolean"
    },
    "procurement_authorized": {
      "title": "Procurement Authorized",
      "type": "boolean"
    },
    "publication_authorized": {
      "title": "Publication Authorized",
      "type": "boolean"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "route_id": {
      "pattern": "^ROUTE-C$",
      "title": "Route Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_selected": {
      "title": "Source Selected",
      "type": "boolean"
    },
    "specimen_acquisition_authorized": {
      "title": "Specimen Acquisition Authorized",
      "type": "boolean"
    },
    "spending_authorized": {
      "title": "Spending Authorized",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/CalibrationPlanningActivationStatus"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "threshold_selection_authorized": {
      "title": "Threshold Selection Authorized",
      "type": "boolean"
    },
    "unresolved_decision_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Unresolved Decision Ids",
      "type": "array"
    }
  },
  "required": [
    "activation_version",
    "study_id",
    "question_id",
    "question_version",
    "route_id",
    "status",
    "design_sha256",
    "founder_decision_sha256",
    "decision_packet_sha256",
    "code_revision",
    "activated_at",
    "unresolved_decision_ids",
    "internal_scientific_planning_authorized",
    "internal_statistical_planning_authorized",
    "internal_operational_scenario_planning_authorized",
    "internal_budget_scenario_planning_authorized",
    "final_human_review_preserved",
    "external_contact_authorized",
    "laboratory_quote_authorized",
    "spending_authorized",
    "procurement_authorized",
    "specimen_acquisition_authorized",
    "source_selected",
    "data_access_authorized",
    "threshold_selection_authorized",
    "study_execution_authorized",
    "clinical_use_authorized",
    "publication_authorized"
  ],
  "title": "ProspectiveCalibrationPlanningActivation",
  "type": "object"
}
