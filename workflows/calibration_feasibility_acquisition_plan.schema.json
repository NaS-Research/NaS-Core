{
  "$defs": {
    "CalibrationFeasibilityArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/CalibrationFeasibilityArtifactKind"
        },
        "expected_content_length_bytes": {
          "exclusiveMinimum": 0,
          "title": "Expected Content Length Bytes",
          "type": "integer"
        },
        "expected_content_type": {
          "minLength": 1,
          "title": "Expected Content Type",
          "type": "string"
        },
        "file_accession": {
          "pattern": "^(GSE|GSM)[0-9]+$",
          "title": "File Accession",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "object_key": {
          "pattern": "^raw/nas-brca-002/[a-z0-9._/-]+$",
          "title": "Object Key",
          "type": "string"
        },
        "official_url": {
          "pattern": "^https://www\\.ncbi\\.nlm\\.nih\\.gov/geo/download/\\?",
          "title": "Official Url",
          "type": "string"
        },
        "source_accession": {
          "pattern": "^GSE(60788|130397)$",
          "title": "Source Accession",
          "type": "string"
        },
        "source_id": {
          "pattern": "^ncbi-geo-gse(60788|130397)$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_accession",
        "file_accession",
        "artifact_kind",
        "filename",
        "official_url",
        "expected_content_length_bytes",
        "expected_content_type",
        "object_key"
      ],
      "title": "CalibrationFeasibilityArtifact",
      "type": "object"
    },
    "CalibrationFeasibilityArtifactKind": {
      "enum": [
        "processed_expression",
        "feature_map",
        "file_inventory"
      ],
      "title": "CalibrationFeasibilityArtifactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/CalibrationFeasibilityArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "calibration_readiness_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Readiness Receipt Sha256",
      "type": "string"
    },
    "classifier_execution_authorized": {
      "title": "Classifier Execution Authorized",
      "type": "boolean"
    },
    "immutable_write_required": {
      "title": "Immutable Write Required",
      "type": "boolean"
    },
    "intended_role": {
      "pattern": "^excluded_public_calibration_feasibility_only$",
      "title": "Intended Role",
      "type": "string"
    },
    "outcome_fields_requested": {
      "title": "Outcome Fields Requested",
      "type": "boolean"
    },
    "parse_during_acquisition": {
      "title": "Parse During Acquisition",
      "type": "boolean"
    },
    "plan_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Plan Version",
      "type": "string"
    },
    "pooling_authorized": {
      "title": "Pooling Authorized",
      "type": "boolean"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_registry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Registry Sha256",
      "type": "string"
    },
    "standing_authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standing Authorization Sha256",
      "type": "string"
    },
    "storage_readiness_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Storage Readiness Receipt Sha256",
      "type": "string"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "threshold_estimation_authorized": {
      "title": "Threshold Estimation Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "plan_version",
    "study_id",
    "question_id",
    "question_version",
    "intended_role",
    "source_registry_sha256",
    "standing_authorization_sha256",
    "calibration_readiness_receipt_sha256",
    "storage_readiness_receipt_sha256",
    "artifacts",
    "parse_during_acquisition",
    "outcome_fields_requested",
    "pooling_authorized",
    "threshold_estimation_authorized",
    "classifier_execution_authorized",
    "immutable_write_required"
  ],
  "title": "CalibrationFeasibilityAcquisitionPlan",
  "type": "object"
}
