{
  "$defs": {
    "CompletionEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$",
          "title": "Artifact Path",
          "type": "string"
        },
        "proves": {
          "minLength": 1,
          "title": "Proves",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "proves"
      ],
      "title": "CompletionEvidence",
      "type": "object"
    },
    "ResearchPhaseRecord": {
      "additionalProperties": false,
      "properties": {
        "completion_gate": {
          "minLength": 1,
          "title": "Completion Gate",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CompletionEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "open_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Open Requirements",
          "type": "array"
        },
        "phase_number": {
          "maximum": 6,
          "minimum": 0,
          "title": "Phase Number",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ResearchPhaseStatus"
        }
      },
      "required": [
        "phase_number",
        "name",
        "status",
        "completion_gate",
        "evidence",
        "open_requirements"
      ],
      "title": "ResearchPhaseRecord",
      "type": "object"
    },
    "ResearchPhaseStatus": {
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "awaiting_final_human_review"
      ],
      "title": "ResearchPhaseStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Audit Version",
      "type": "string"
    },
    "current_phase": {
      "maximum": 6,
      "minimum": 0,
      "title": "Current Phase",
      "type": "integer"
    },
    "external_publication_authorized": {
      "title": "External Publication Authorized",
      "type": "boolean"
    },
    "external_submission_authorized": {
      "title": "External Submission Authorized",
      "type": "boolean"
    },
    "final_human_review_completed": {
      "title": "Final Human Review Completed",
      "type": "boolean"
    },
    "final_human_review_preserved": {
      "title": "Final Human Review Preserved",
      "type": "boolean"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/ResearchPhaseRecord"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Phases",
      "type": "array"
    },
    "pipeline_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pipeline Manifest Sha256",
      "type": "string"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "ready_for_final_human_review": {
      "title": "Ready For Final Human Review",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_conclusion_authorized": {
      "title": "Scientific Conclusion Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    }
  },
  "required": [
    "audit_version",
    "study_id",
    "question_id",
    "question_version",
    "pipeline_manifest_sha256",
    "current_phase",
    "phases",
    "ready_for_final_human_review",
    "final_human_review_preserved",
    "final_human_review_completed",
    "scientific_conclusion_authorized",
    "external_publication_authorized",
    "external_submission_authorized"
  ],
  "title": "StudyCompletionAudit",
  "type": "object"
}
