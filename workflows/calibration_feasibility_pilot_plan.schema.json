      "pattern": "^unchanged_source_normalized_values$",
      "title": "Gse60788 Transform",
      "type": "string"
    },
    "infer_reliability_threshold": {
      "title": "Infer Reliability Threshold",
      "type": "boolean"
    },
    "pair_metrics": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Pair Metrics",
      "type": "array"
    },
    "panel": {
      "pattern": "^PAM50_historical_50$",
      "title": "Panel",
      "type": "string"
    },
    "plan_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Plan Version",
      "type": "string"
    },
    "pool_sources": {
      "title": "Pool Sources",
      "type": "boolean"
    },
    "publication_authorized": {
      "title": "Publication Authorized",
      "type": "boolean"
    },
    "random_seed": {
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "reliability_specification_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reliability Specification Sha256",
      "type": "string"
    },
    "retain_molecular_values_in_git": {
      "title": "Retain Molecular Values In Git",
      "type": "boolean"
    },
    "retain_source_identifiers": {
      "title": "Retain Source Identifiers",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_summary": {
      "pattern": "^median_across_independent_replicate_groups$",
