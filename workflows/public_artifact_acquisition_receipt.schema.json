{
  "additionalProperties": false,
  "properties": {
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "classifier_executed": {
      "title": "Classifier Executed",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "content_length_bytes": {
      "exclusiveMinimum": 0,
      "title": "Content Length Bytes",
      "type": "integer"
    },
    "external_publication_authorized": {
      "title": "External Publication Authorized",
      "type": "boolean"
    },
    "immutable_object_verified": {
      "title": "Immutable Object Verified",
      "type": "boolean"
    },
    "molecular_source_bytes_stored": {
      "title": "Molecular Source Bytes Stored",
      "type": "boolean"
    },
    "molecular_values_parsed": {
      "title": "Molecular Values Parsed",
      "type": "boolean"
    },
    "object_key": {
      "pattern": "^raw/[a-z0-9._/-]+$",
      "title": "Object Key",
      "type": "string"
    },
    "official_url": {
      "pattern": "^https://",
      "title": "Official Url",
      "type": "string"
    },
    "outcome_values_accessed": {
      "title": "Outcome Values Accessed",
      "type": "boolean"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "response_content_type": {
      "minLength": 1,
      "title": "Response Content Type",
      "type": "string"
    },
    "response_last_modified": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Response Last Modified"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source_accession": {
      "pattern": "^GSE[0-9]+$",
      "title": "Source Accession",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "source_id",
    "source_accession",
    "code_revision",
    "acquired_at",
    "plan_sha256",
    "official_url",
    "response_content_type",
    "response_last_modified",
    "content_length_bytes",
    "sha256",
    "object_key",
    "immutable_object_verified",
    "molecular_source_bytes_stored",
    "molecular_values_parsed",
    "outcome_values_accessed",
    "classifier_executed",
    "external_publication_authorized"
  ],
  "title": "PublicArtifactAcquisitionReceipt",
  "type": "object"
}
