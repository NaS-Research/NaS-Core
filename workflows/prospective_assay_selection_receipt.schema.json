{
  "additionalProperties": false,
  "properties": {
    "candidate_count": {
      "minimum": 3,
      "title": "Candidate Count",
      "type": "integer"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "decision": {
      "pattern": "^prospective_assay_family_selected_for_planning$",
      "title": "Decision",
      "type": "string"
    },
    "dependency_hashes_verified": {
      "title": "Dependency Hashes Verified",
      "type": "boolean"
    },
    "exact_chemistry_unresolved": {
      "title": "Exact Chemistry Unresolved",
      "type": "boolean"
    },
    "exact_instrument_unresolved": {
      "title": "Exact Instrument Unresolved",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Next Actions",
      "type": "array"
    },
    "no_external_action_preserved": {
      "title": "No External Action Preserved",
      "type": "boolean"
    },
    "outcomes_accessed": {
      "title": "Outcomes Accessed",
      "type": "boolean"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "platform_conformance_required": {
      "title": "Platform Conformance Required",
      "type": "boolean"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_candidate_id": {
      "title": "Selected Candidate Id",
      "type": "string"
    },
    "selected_platform_family": {
      "title": "Selected Platform Family",
      "type": "string"
    },
    "selection_scope": {
      "pattern": "^planning_only_platform_family$",
      "title": "Selection Scope",
      "type": "string"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "validation_values_accessed": {
      "title": "Validation Values Accessed",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "code_revision",
    "plan_sha256",
    "dependency_hashes_verified",
    "candidate_count",
    "selected_candidate_id",
    "selected_platform_family",
    "selection_scope",
    "exact_chemistry_unresolved",
    "exact_instrument_unresolved",
    "platform_conformance_required",
    "no_external_action_preserved",
    "decision",
    "study_execution_authorized",
    "molecular_values_accessed",
    "outcomes_accessed",
    "validation_values_accessed",
    "limitations",
    "next_actions"
  ],
  "title": "ProspectiveAssaySelectionReceipt",
  "type": "object"
}
