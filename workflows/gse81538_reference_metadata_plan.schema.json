{
  "additionalProperties": false,
  "properties": {
    "deterministic_ordering": {
      "pattern": "^lexicographic_geo_accession$",
      "title": "Deterministic Ordering",
      "type": "string"
    },
    "er_consensus_field": {
      "pattern": "^er consensus$",
      "title": "Er Consensus Field",
      "type": "string"
    },
    "er_negative_consensus_code": {
      "maximum": 3,
      "minimum": 0,
      "title": "Er Negative Consensus Code",
      "type": "integer"
    },
    "er_positive_consensus_code": {
      "maximum": 3,
      "minimum": 0,
      "title": "Er Positive Consensus Code",
      "type": "integer"
    },
    "excluded_er_consensus_codes": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Excluded Er Consensus Codes",
      "type": "array"
    },
    "expected_metadata_bytes": {
      "exclusiveMinimum": 0,
      "title": "Expected Metadata Bytes",
      "type": "integer"
    },
    "expected_metadata_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Metadata Sha256",
      "type": "string"
    },
    "expected_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Expected Sample Count",
      "type": "integer"
    },
    "expected_title_prefix": {
      "pattern": "^T$",
      "title": "Expected Title Prefix",
      "type": "string"
    },
    "expression_values_permitted": {
      "title": "Expression Values Permitted",
      "type": "boolean"
    },
    "founder_decision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Founder Decision Sha256",
      "type": "string"
    },
    "generative_ai_processing_permitted": {
      "title": "Generative Ai Processing Permitted",
      "type": "boolean"
    },
    "manifest_object_key": {
      "pattern": "^derived/[a-z0-9._/-]+$",
      "title": "Manifest Object Key",
      "type": "string"
    },
    "matrix_audit_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Matrix Audit Receipt Sha256",
      "type": "string"
    },
    "metadata_acquisition_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Metadata Acquisition Receipt Sha256",
      "type": "string"
    },
    "metadata_object_key": {
      "pattern": "^raw/[a-z0-9._/-]+$",
      "title": "Metadata Object Key",
      "type": "string"
    },
    "outcome_fields_permitted": {
      "title": "Outcome Fields Permitted",
      "type": "boolean"
    },
    "permitted_sample_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Permitted Sample Fields",
      "type": "array"
    },
    "plan_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Plan Version",
      "type": "string"
    },
    "primary_source_url": {
      "pattern": "^https://",
      "title": "Primary Source Url",
      "type": "string"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "reference_protocol_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reference Protocol Sha256",
      "type": "string"
    },
    "samples_per_stratum": {
      "exclusiveMinimum": 0,
      "title": "Samples Per Stratum",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_accession": {
      "pattern": "^GSE81538$",
      "title": "Source Accession",
      "type": "string"
    },
    "source_id": {
      "pattern": "^ncbi-geo-gse81538$",
      "title": "Source Id",
      "type": "string"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "validation_data_permitted": {
      "title": "Validation Data Permitted",
      "type": "boolean"
    }
  },
  "required": [
    "plan_version",
    "study_id",
    "question_id",
    "question_version",
    "source_id",
    "source_accession",
    "metadata_object_key",
    "metadata_acquisition_receipt_sha256",
    "matrix_audit_receipt_sha256",
    "founder_decision_sha256",
    "reference_protocol_sha256",
    "expected_metadata_sha256",
    "expected_metadata_bytes",
    "expected_sample_count",
    "expected_title_prefix",
    "permitted_sample_fields",
    "er_consensus_field",
    "er_negative_consensus_code",
    "er_positive_consensus_code",
    "excluded_er_consensus_codes",
    "samples_per_stratum",
    "deterministic_ordering",
    "manifest_object_key",
    "primary_source_url",
    "outcome_fields_permitted",
    "expression_values_permitted",
    "validation_data_permitted",
    "generative_ai_processing_permitted"
  ],
  "title": "GSE81538ReferenceMetadataPlan",
  "type": "object"
}
