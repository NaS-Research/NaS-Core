{
  "$defs": {
    "CalibrationAcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^CAL-[0-9]{3}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "requirement": {
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "resolution_status": {
          "pattern": "^(unresolved|satisfied)$",
          "title": "Resolution Status",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "requirement",
        "rationale",
        "resolution_status"
      ],
      "title": "CalibrationAcceptanceCriterion",
      "type": "object"
    },
    "CalibrationAccessClass": {
      "enum": [
        "public_open",
        "licensed",
        "controlled",
        "not_yet_created"
      ],
      "title": "CalibrationAccessClass",
      "type": "string"
    },
    "CalibrationSourceCandidate": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "$ref": "#/$defs/CalibrationAccessClass"
        },
        "assay_or_platform": {
          "minLength": 1,
          "title": "Assay Or Platform",
          "type": "string"
        },
        "candidate_for_threshold_calibration": {
          "title": "Candidate For Threshold Calibration",
          "type": "boolean"
        },
        "disposition": {
          "$ref": "#/$defs/CalibrationSourceDisposition"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "full_classifier_panel_confirmed": {
          "title": "Full Classifier Panel Confirmed",
          "type": "boolean"
        },
        "independent_from_classifier_training": {
          "title": "Independent From Classifier Training",
          "type": "boolean"
        },
        "independent_from_external_validation": {
          "title": "Independent From External Validation",
          "type": "boolean"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "lawful_access_verified": {
          "title": "Lawful Access Verified",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "paired_measurements_reported": {
          "title": "Paired Measurements Reported",
          "type": "boolean"
        },
        "participant_level_molecular_values_available": {
          "title": "Participant Level Molecular Values Available",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^CALSRC-[0-9]{3}$",
          "title": "Source Id",
          "type": "string"
        },
        "stable_pair_identifiers_available": {
          "title": "Stable Pair Identifiers Available",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "label",
        "evidence_ids",
        "assay_or_platform",
        "access_class",
        "disposition",
        "independent_from_classifier_training",
        "independent_from_external_validation",
        "paired_measurements_reported",
        "participant_level_molecular_values_available",
        "stable_pair_identifiers_available",
        "full_classifier_panel_confirmed",
        "lawful_access_verified",
        "candidate_for_threshold_calibration",
        "limitations"
      ],
      "title": "CalibrationSourceCandidate",
      "type": "object"
    },
    "CalibrationSourceDisposition": {
      "enum": [
        "reserved_external_validation",
        "participant_level_data_unavailable",
        "requires_due_diligence",
        "future_nas_experiment"
      ],
      "title": "CalibrationSourceDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/CalibrationAcceptanceCriterion"
      },
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "centroid_candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Centroid Candidate Sha256",
      "type": "string"
    },
    "clinical_use_authorized": {
      "title": "Clinical Use Authorized",
      "type": "boolean"
    },
    "founder_route_selected": {
      "title": "Founder Route Selected",
      "type": "boolean"
    },
    "method_dependency_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Method Dependency Audit Sha256",
      "type": "string"
    },
    "method_execution_authorized": {
      "title": "Method Execution Authorized",
      "type": "boolean"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Next Actions",
      "type": "array"
    },
    "outcome_data_accessed": {
      "title": "Outcome Data Accessed",
      "type": "boolean"
    },
    "patient_level_data_accessed": {
      "title": "Patient Level Data Accessed",
      "type": "boolean"
    },
    "plan_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Plan Version",
      "type": "string"
    },
    "power_analysis_required_before_minimum_pair_count": {
      "title": "Power Analysis Required Before Minimum Pair Count",
      "type": "boolean"
    },
    "prohibited_uses": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Prohibited Uses",
      "type": "array"
    },
    "publication_authorized": {
      "title": "Publication Authorized",
      "type": "boolean"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Source Id"
    },
    "source_candidates": {
      "items": {
        "$ref": "#/$defs/CalibrationSourceCandidate"
      },
      "minItems": 1,
      "title": "Source Candidates",
      "type": "array"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "threshold_selection_authorized": {
      "title": "Threshold Selection Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "plan_version",
    "study_id",
    "question_id",
    "question_version",
    "method_dependency_audit_sha256",
    "centroid_candidate_sha256",
    "purpose",
    "prohibited_uses",
    "acceptance_criteria",
    "source_candidates",
    "selected_source_id",
    "founder_route_selected",
    "power_analysis_required_before_minimum_pair_count",
    "next_actions",
    "patient_level_data_accessed",
    "molecular_values_accessed",
    "outcome_data_accessed",
    "threshold_selection_authorized",
    "method_execution_authorized",
    "clinical_use_authorized",
    "publication_authorized"
  ],
  "title": "TechnicalCalibrationAcquisitionPlan",
  "type": "object"
}
