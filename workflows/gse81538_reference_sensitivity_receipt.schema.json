      "type": "array"
    },
    "matrix_audit_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Matrix Audit Receipt Sha256",
      "type": "string"
    },
    "molecular_values_parsed": {
      "title": "Molecular Values Parsed",
      "type": "boolean"
    },
    "next_er_negative_available": {
      "minimum": 0,
      "title": "Next Er Negative Available",
      "type": "integer"
    },
    "next_er_positive_available": {
      "minimum": 0,
      "title": "Next Er Positive Available",
      "type": "integer"
    },
    "outcome_values_accessed": {
      "title": "Outcome Values Accessed",
      "type": "boolean"
    },
    "parsed_measurement_count": {
