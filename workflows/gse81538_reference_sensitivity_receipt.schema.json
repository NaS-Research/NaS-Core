      "pattern": "^[a-f0-9]{64}$",
      "title": "Reference Protocol Sha256",
      "type": "string"
    },
    "reference_values_retained_in_git": {
      "title": "Reference Values Retained In Git",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity_bytes": {
