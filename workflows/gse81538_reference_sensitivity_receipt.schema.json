      "exclusiveMinimum": 0,
      "title": "Alternative Target Per Stratum",
      "type": "integer"
    },
    "centered_profile_correlation_mean": {
      "maximum": 1,
      "minimum": -1,
      "title": "Centered Profile Correlation Mean",
      "type": "number"
    },
    "centered_profile_correlation_median": {
      "maximum": 1,
      "minimum": -1,
      "title": "Centered Profile Correlation Median",
      "type": "number"
    },
    "centered_profile_correlation_minimum": {
      "maximum": 1,
      "minimum": -1,
      "title": "Centered Profile Correlation Minimum",
      "type": "number"
    },
