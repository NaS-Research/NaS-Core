    "vector_pearson_correlation",
    "vector_spearman_correlation",
    "vector_mean_absolute_difference",
    "vector_maximum_absolute_difference",
    "vector_root_mean_square_difference",
    "centered_profile_correlation_minimum",
    "centered_profile_correlation_median",
    "centered_profile_correlation_mean",
    "next_er_negative_available",
    "next_er_positive_available",
    "alternative_target_per_stratum",
    "exact_alternative_balanced_reference_feasible",
    "exact_alternative_reference_constructed",
    "sensitivity_object_key",
    "sensitivity_sha256",
    "sensitivity_bytes",
    "sensitivity_immutable_verified",
    "decision",
    "limitations",
