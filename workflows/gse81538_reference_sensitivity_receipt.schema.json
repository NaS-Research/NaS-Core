      "pattern": "^[a-f0-9]{64}$",
      "title": "Centroid Candidate Sha256",
      "type": "string"
    },
    "classifier_executed": {
      "title": "Classifier Executed",
      "type": "boolean"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
