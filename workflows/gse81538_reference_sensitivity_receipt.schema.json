    },
    "exact_alternative_balanced_reference_feasible": {
      "title": "Exact Alternative Balanced Reference Feasible",
      "type": "boolean"
    },
    "exact_alternative_reference_constructed": {
      "title": "Exact Alternative Reference Constructed",
      "type": "boolean"
    },
    "executed_at": {
