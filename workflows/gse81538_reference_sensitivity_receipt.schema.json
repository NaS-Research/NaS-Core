      "exclusiveMinimum": 0,
      "title": "Trimmed Observations Per Gene",
      "type": "integer"
    },
    "validation_data_accessed": {
      "title": "Validation Data Accessed",
      "type": "boolean"
    },
    "vector_maximum_absolute_difference": {
      "minimum": 0,
      "title": "Vector Maximum Absolute Difference",
      "type": "number"
    },
    "vector_mean_absolute_difference": {
      "minimum": 0,
      "title": "Vector Mean Absolute Difference",
      "type": "number"
    },
    "vector_pearson_correlation": {
      "maximum": 1,
      "minimum": -1,
      "title": "Vector Pearson Correlation",
      "type": "number"
    },
    "vector_root_mean_square_difference": {
      "minimum": 0,
      "title": "Vector Root Mean Square Difference",
      "type": "number"
    },
    "vector_spearman_correlation": {
      "maximum": 1,
      "minimum": -1,
      "title": "Vector Spearman Correlation",
      "type": "number"
    }
