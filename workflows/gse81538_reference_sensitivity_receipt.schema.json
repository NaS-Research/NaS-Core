    "primary_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Primary Sample Count",
      "type": "integer"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
