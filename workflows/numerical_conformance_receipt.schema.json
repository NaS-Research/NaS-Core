{
  "$defs": {
    "NumericalConformanceCaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^CONF-[A-Z0-9-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "labels_match": {
          "title": "Labels Match",
          "type": "boolean"
        },
        "margin_absolute_difference": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Absolute Difference"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "production_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Production Label"
        },
        "production_reason": {
          "title": "Production Reason",
          "type": "string"
        },
        "production_runner_up": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Production Runner Up"
        },
        "ranks_match": {
          "title": "Ranks Match",
          "type": "boolean"
        },
        "reasons_match": {
          "title": "Reasons Match",
          "type": "boolean"
        },
        "reference_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Label"
        },
        "reference_reason": {
          "title": "Reference Reason",
          "type": "string"
        },
        "reference_runner_up": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Runner Up"
        },
        "runner_up_score_absolute_difference": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Up Score Absolute Difference"
        },
        "tolerance_passed": {
          "title": "Tolerance Passed",
          "type": "boolean"
        },
        "top_score_absolute_difference": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Score Absolute Difference"
        }
      },
      "required": [
        "case_id",
        "production_label",
        "reference_label",
        "production_runner_up",
        "reference_runner_up",
        "production_reason",
        "reference_reason",
        "labels_match",
        "ranks_match",
        "reasons_match",
        "tolerance_passed",
        "passed"
      ],
      "title": "NumericalConformanceCaseResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "absolute_margin_tolerance": {
      "exclusiveMinimum": 0.0,
      "maximum": 1e-10,
      "title": "Absolute Margin Tolerance",
      "type": "number"
    },
    "absolute_score_tolerance": {
      "exclusiveMinimum": 0.0,
      "maximum": 1e-10,
      "title": "Absolute Score Tolerance",
      "type": "number"
    },
    "analytical_validity_claimed": {
      "title": "Analytical Validity Claimed",
      "type": "boolean"
    },
    "candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/NumericalConformanceCaseResult"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Cases",
      "type": "array"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "executed_at": {
      "format": "date-time",
      "title": "Executed At",
      "type": "string"
    },
    "failed_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Failed Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "method_lock_authorized": {
      "title": "Method Lock Authorized",
      "type": "boolean"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "outcomes_accessed": {
      "title": "Outcomes Accessed",
      "type": "boolean"
    },
    "overall_passed": {
      "title": "Overall Passed",
      "type": "boolean"
    },
    "passed_count": {
      "maximum": 8,
      "minimum": 0,
      "title": "Passed Count",
      "type": "integer"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "production_kernel_version": {
      "title": "Production Kernel Version",
      "type": "string"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "reference_implementation": {
      "title": "Reference Implementation",
      "type": "string"
    },
    "reliability_specification_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reliability Specification Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "synthetic_only": {
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "question_id",
    "question_version",
    "code_revision",
    "executed_at",
    "plan_sha256",
    "candidate_sha256",
    "reliability_specification_sha256",
    "production_kernel_version",
    "reference_implementation",
    "absolute_score_tolerance",
    "absolute_margin_tolerance",
    "cases",
    "passed_count",
    "failed_count",
    "overall_passed",
    "limitations",
    "synthetic_only",
    "molecular_values_accessed",
    "outcomes_accessed",
    "analytical_validity_claimed",
    "method_lock_authorized",
    "study_execution_authorized"
  ],
  "title": "NumericalConformanceReceipt",
  "type": "object"
}
