{
  "$defs": {
    "CalibrationArmRole": {
      "enum": [
        "feasibility_pilot",
        "primary_calibration",
        "extraction_sensitivity"
      ],
      "title": "CalibrationArmRole",
      "type": "string"
    },
    "CalibrationDecisionItem": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "pattern": "^CAL-DEC-[0-9]{3}$",
          "title": "Decision Id",
          "type": "string"
        },
        "founder_decision_required": {
          "title": "Founder Decision Required",
          "type": "boolean"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommendation": {
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CalibrationParameterStatus"
        }
      },
      "required": [
        "decision_id",
        "question",
        "recommendation",
        "rationale",
        "status",
        "founder_decision_required"
      ],
      "title": "CalibrationDecisionItem",
      "type": "object"
    },
    "CalibrationDesignStatus": {
      "enum": [
        "founder_review_required"
      ],
      "title": "CalibrationDesignStatus",
      "type": "string"
    },
    "CalibrationEstimand": {
      "additionalProperties": false,
      "properties": {
        "clinical_outcomes_used": {
          "title": "Clinical Outcomes Used",
          "type": "boolean"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "estimand_id": {
          "pattern": "^CAL-EST-[0-9]{3}$",
          "title": "Estimand Id",
          "type": "string"
        },
        "multiplicity_family": {
          "minLength": 1,
          "title": "Multiplicity Family",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameter_status": {
          "$ref": "#/$defs/CalibrationParameterStatus"
        },
        "primary": {
          "title": "Primary",
          "type": "boolean"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "estimand_id",
        "name",
        "unit",
        "primary",
        "definition",
        "multiplicity_family",
        "parameter_status",
        "clinical_outcomes_used"
      ],
      "title": "CalibrationEstimand",
      "type": "object"
    },
    "CalibrationParameterStatus": {
      "enum": [
        "hypothetical",
        "requires_pilot",
        "requires_founder_review"
      ],
      "title": "CalibrationParameterStatus",
      "type": "string"
    },
    "TechnicalReplicateArm": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "pattern": "^CAL-ARM-[0-9]{3}$",
          "title": "Arm Id",
          "type": "string"
        },
        "included_in_threshold_calibration": {
          "title": "Included In Threshold Calibration",
          "type": "boolean"
        },
        "independent_steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Independent Steps",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "pair_count": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Count"
        },
        "pair_count_status": {
          "$ref": "#/$defs/CalibrationParameterStatus"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/CalibrationArmRole"
        },
        "shared_steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Shared Steps",
          "type": "array"
        },
        "specimen_nonoverlap_required": {
          "title": "Specimen Nonoverlap Required",
          "type": "boolean"
        },
        "technical_unit": {
          "minLength": 1,
          "title": "Technical Unit",
          "type": "string"
        }
      },
      "required": [
        "arm_id",
        "role",
        "purpose",
        "technical_unit",
        "independent_steps",
        "shared_steps",
        "included_in_threshold_calibration",
        "specimen_nonoverlap_required",
        "pair_count_status",
        "limitations"
      ],
      "title": "TechnicalReplicateArm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_gates": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Acceptance Gates",
      "type": "array"
    },
    "acquisition_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Acquisition Plan Sha256",
      "type": "string"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/TechnicalReplicateArm"
      },
      "minItems": 2,
      "title": "Arms",
      "type": "array"
    },
    "assay_workflow": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assay Workflow",
      "type": "array"
    },
    "clinical_use_authorized": {
      "title": "Clinical Use Authorized",
      "type": "boolean"
    },
    "contact_revocation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contact Revocation Sha256",
      "type": "string"
    },
    "data_firewalls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Data Firewalls",
      "type": "array"
    },
    "design_principles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Design Principles",
      "type": "array"
    },
    "design_status": {
      "$ref": "#/$defs/CalibrationDesignStatus"
    },
    "design_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Design Version",
      "type": "string"
    },
    "estimands": {
      "items": {
        "$ref": "#/$defs/CalibrationEstimand"
      },
      "minItems": 2,
      "title": "Estimands",
      "type": "array"
    },
    "external_contact_authorized": {
      "title": "External Contact Authorized",
      "type": "boolean"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "no_go_criteria": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "No Go Criteria",
      "type": "array"
    },
    "outcome_data_accessed": {
      "title": "Outcome Data Accessed",
      "type": "boolean"
    },
    "patient_level_data_accessed": {
      "title": "Patient Level Data Accessed",
      "type": "boolean"
    },
    "phase": {
      "pattern": "^phase_1_method_calibration$",
      "title": "Phase",
      "type": "string"
    },
    "procurement_authorized": {
      "title": "Procurement Authorized",
      "type": "boolean"
    },
    "publication_authorized": {
      "title": "Publication Authorized",
      "type": "boolean"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "quality_controls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Quality Controls",
      "type": "array"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "route_activation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Route Activation Sha256",
      "type": "string"
    },
    "route_id": {
      "pattern": "^ROUTE-C$",
      "title": "Route Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_selected": {
      "title": "Source Selected",
      "type": "boolean"
    },
    "specimen_acquisition_authorized": {
      "title": "Specimen Acquisition Authorized",
      "type": "boolean"
    },
    "specimen_requirements": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Specimen Requirements",
      "type": "array"
    },
    "spending_authorized": {
      "title": "Spending Authorized",
      "type": "boolean"
    },
    "statistical_design": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Statistical Design",
      "type": "array"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "threshold_calibration_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Threshold Calibration Source Ids",
      "type": "array"
    },
    "threshold_selection_authorized": {
      "title": "Threshold Selection Authorized",
      "type": "boolean"
    },
    "unresolved_decisions": {
      "items": {
        "$ref": "#/$defs/CalibrationDecisionItem"
      },
      "minItems": 1,
      "title": "Unresolved Decisions",
      "type": "array"
    },
    "validation_source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Validation Source Ids",
      "type": "array"
    }
  },
  "required": [
    "design_version",
    "study_id",
    "question_id",
    "question_version",
    "phase",
    "route_id",
    "design_status",
    "route_activation_sha256",
    "acquisition_plan_sha256",
    "contact_revocation_sha256",
    "purpose",
    "design_principles",
    "specimen_requirements",
    "assay_workflow",
    "arms",
    "estimands",
    "quality_controls",
    "statistical_design",
    "data_firewalls",
    "acceptance_gates",
    "no_go_criteria",
    "unresolved_decisions",
    "validation_source_ids",
    "threshold_calibration_source_ids",
    "external_contact_authorized",
    "spending_authorized",
    "procurement_authorized",
    "specimen_acquisition_authorized",
    "source_selected",
    "patient_level_data_accessed",
    "molecular_values_accessed",
    "outcome_data_accessed",
    "threshold_selection_authorized",
    "study_execution_authorized",
    "clinical_use_authorized",
    "publication_authorized"
  ],
  "title": "ProspectiveCalibrationExperimentDesign",
  "type": "object"
}
