{
  "additionalProperties": false,
  "properties": {
    "candidate_count": {
      "minimum": 5,
      "title": "Candidate Count",
      "type": "integer"
    },
    "code_revision": {
      "pattern": "^[a-f0-9]{7,40}$",
      "title": "Code Revision",
      "type": "string"
    },
    "decision": {
      "pattern": "^no_verified_source_external_due_diligence_required$",
      "title": "Decision",
      "type": "string"
    },
    "dependency_hashes_verified": {
      "title": "Dependency Hashes Verified",
      "type": "boolean"
    },
    "external_action_authorized": {
      "title": "External Action Authorized",
      "type": "boolean"
    },
    "ineligible_count": {
      "minimum": 0,
      "title": "Ineligible Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Next Actions",
      "type": "array"
    },
    "no_contact_preserved": {
      "title": "No Contact Preserved",
      "type": "boolean"
    },
    "outcomes_accessed": {
      "title": "Outcomes Accessed",
      "type": "boolean"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Receipt Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Source Id"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "unresolved_count": {
      "minimum": 0,
      "title": "Unresolved Count",
      "type": "integer"
    },
    "validation_values_accessed": {
      "title": "Validation Values Accessed",
      "type": "boolean"
    },
    "verified_eligible_count": {
      "minimum": 0,
      "title": "Verified Eligible Count",
      "type": "integer"
    }
  },
  "required": [
    "receipt_version",
    "study_id",
    "code_revision",
    "plan_sha256",
    "dependency_hashes_verified",
    "candidate_count",
    "verified_eligible_count",
    "unresolved_count",
    "ineligible_count",
    "selected_source_id",
    "no_contact_preserved",
    "decision",
    "external_action_authorized",
    "study_execution_authorized",
    "molecular_values_accessed",
    "outcomes_accessed",
    "validation_values_accessed",
    "limitations",
    "next_actions"
  ],
  "title": "PilotSourceLandscapeReceipt",
  "type": "object"
}
