{
  "$defs": {
    "PreprocessingBridgeCandidate": {
      "additionalProperties": false,
      "properties": {
        "centering_operation": {
          "minLength": 1,
          "title": "Centering Operation",
          "type": "string"
        },
        "duplicate_gene_rule": {
          "minLength": 1,
          "title": "Duplicate Gene Rule",
          "type": "string"
        },
        "gene_identifier": {
          "minLength": 1,
          "title": "Gene Identifier",
          "type": "string"
        },
        "missing_gene_rule": {
          "minLength": 1,
          "title": "Missing Gene Rule",
          "type": "string"
        },
        "pseudocount": {
          "exclusiveMinimum": 0,
          "title": "Pseudocount",
          "type": "number"
        },
        "reference_statistic": {
          "minLength": 1,
          "title": "Reference Statistic",
          "type": "string"
        },
        "source_quantity": {
          "minLength": 1,
          "title": "Source Quantity",
          "type": "string"
        },
        "source_scale_status": {
          "minLength": 1,
          "title": "Source Scale Status",
          "type": "string"
        },
        "target_quantity": {
          "minLength": 1,
          "title": "Target Quantity",
          "type": "string"
        },
        "target_transform": {
          "minLength": 1,
          "title": "Target Transform",
          "type": "string"
        },
        "transformation_locked": {
          "title": "Transformation Locked",
          "type": "boolean"
        },
        "unit_audit_required": {
          "title": "Unit Audit Required",
          "type": "boolean"
        }
      },
      "required": [
        "source_quantity",
        "source_scale_status",
        "target_quantity",
        "target_transform",
        "pseudocount",
        "gene_identifier",
        "duplicate_gene_rule",
        "missing_gene_rule",
        "reference_statistic",
        "centering_operation",
        "unit_audit_required",
        "transformation_locked"
      ],
      "title": "PreprocessingBridgeCandidate",
      "type": "object"
    },
    "ReferenceDevelopmentRole": {
      "enum": [
        "reference_development_only"
      ],
      "title": "ReferenceDevelopmentRole",
      "type": "string"
    },
    "ReferenceSubsetRule": {
      "additionalProperties": false,
      "properties": {
        "deterministic_ordering": {
          "minLength": 1,
          "title": "Deterministic Ordering",
          "type": "string"
        },
        "eligible_material": {
          "minLength": 1,
          "title": "Eligible Material",
          "type": "string"
        },
        "molecular_values_permitted_during_selection": {
          "title": "Molecular Values Permitted During Selection",
          "type": "boolean"
        },
        "outcome_fields_permitted": {
          "title": "Outcome Fields Permitted",
          "type": "boolean"
        },
        "receptor_field": {
          "minLength": 1,
          "title": "Receptor Field",
          "type": "string"
        },
        "receptor_strata": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Receptor Strata",
          "type": "array"
        },
        "samples_per_stratum": {
          "exclusiveMinimum": 0,
          "title": "Samples Per Stratum",
          "type": "integer"
        }
      },
      "required": [
        "eligible_material",
        "receptor_field",
        "receptor_strata",
        "samples_per_stratum",
        "deterministic_ordering",
        "outcome_fields_permitted",
        "molecular_values_permitted_during_selection"
      ],
      "title": "ReferenceSubsetRule",
      "type": "object"
    },
    "SourceSelectionStatus": {
      "enum": [
        "candidate",
        "locked"
      ],
      "title": "SourceSelectionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classifier_executed": {
      "title": "Classifier Executed",
      "type": "boolean"
    },
    "expected_public_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Expected Public Sample Count",
      "type": "integer"
    },
    "external_publication_authorized": {
      "title": "External Publication Authorized",
      "type": "boolean"
    },
    "firewalls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Firewalls",
      "type": "array"
    },
    "intended_role": {
      "$ref": "#/$defs/ReferenceDevelopmentRole"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "matrix_audit_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matrix Audit Receipt Sha256"
    },
    "metadata_acquisition_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Acquisition Receipt Sha256"
    },
    "molecular_values_accessed": {
      "title": "Molecular Values Accessed",
      "type": "boolean"
    },
    "numerical_conformance_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Numerical Conformance Sha256",
      "type": "string"
    },
    "official_metadata_url": {
      "pattern": "^https://",
      "title": "Official Metadata Url",
      "type": "string"
    },
    "outcome_values_accessed": {
      "title": "Outcome Values Accessed",
      "type": "boolean"
    },
    "participant_nonoverlap_status": {
      "minLength": 1,
      "title": "Participant Nonoverlap Status",
      "type": "string"
    },
    "platform_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Platform Audit Sha256",
      "type": "string"
    },
    "preprocessing_bridge": {
      "$ref": "#/$defs/PreprocessingBridgeCandidate"
    },
    "proposed_processed_artifact": {
      "minLength": 1,
      "title": "Proposed Processed Artifact",
      "type": "string"
    },
    "protocol_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Protocol Version",
      "type": "string"
    },
    "question_id": {
      "pattern": "^NAS-RQ-[A-Z0-9]+$",
      "title": "Question Id",
      "type": "string"
    },
    "question_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Question Version",
      "type": "string"
    },
    "reference_input_founder_decision_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Input Founder Decision Sha256"
    },
    "reference_locked": {
      "title": "Reference Locked",
      "type": "boolean"
    },
    "reference_vector_materialized": {
      "title": "Reference Vector Materialized",
      "type": "boolean"
    },
    "relationship_to_validation": {
      "minLength": 1,
      "title": "Relationship To Validation",
      "type": "string"
    },
    "required_pre_acquisition_checks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Pre Acquisition Checks",
      "type": "array"
    },
    "route_id": {
      "pattern": "^ROUTE-C$",
      "title": "Route Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity_analyses": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Sensitivity Analyses",
      "type": "array"
    },
    "source_accession": {
      "pattern": "^GSE[0-9]+$",
      "title": "Source Accession",
      "type": "string"
    },
    "source_bytes_stored": {
      "title": "Source Bytes Stored",
      "type": "boolean"
    },
    "source_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "source_registry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Registry Sha256",
      "type": "string"
    },
    "source_selection_status": {
      "$ref": "#/$defs/SourceSelectionStatus"
    },
    "standing_authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standing Authorization Sha256",
      "type": "string"
    },
    "study_execution_authorized": {
      "title": "Study Execution Authorized",
      "type": "boolean"
    },
    "study_id": {
      "pattern": "^NAS-[A-Z0-9]+-[0-9]{3}$",
      "title": "Study Id",
      "type": "string"
    },
    "subset_rule": {
      "$ref": "#/$defs/ReferenceSubsetRule"
    },
    "supersedes_protocol_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Protocol Sha256"
    }
  },
  "required": [
    "protocol_version",
    "study_id",
    "question_id",
    "question_version",
    "route_id",
    "source_id",
    "source_accession",
    "intended_role",
    "source_selection_status",
    "source_registry_sha256",
    "standing_authorization_sha256",
    "platform_audit_sha256",
    "numerical_conformance_sha256",
    "official_metadata_url",
    "proposed_processed_artifact",
    "expected_public_sample_count",
    "relationship_to_validation",
    "participant_nonoverlap_status",
    "subset_rule",
    "preprocessing_bridge",
    "required_pre_acquisition_checks",
    "sensitivity_analyses",
    "firewalls",
    "limitations",
    "molecular_values_accessed",
    "outcome_values_accessed",
    "source_bytes_stored",
    "reference_vector_materialized",
    "classifier_executed",
    "reference_locked",
    "study_execution_authorized",
    "external_publication_authorized"
  ],
  "title": "ReferenceDevelopmentProtocol",
  "type": "object"
}
